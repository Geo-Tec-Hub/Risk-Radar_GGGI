# Copy to backend/.env and fill in. .env is gitignored; this file is not.
# The password must never be committed, pasted into a chat, or typed at an
# interactive PowerShell prompt — PSReadLine writes every command line to
# ConsoleHost_history.txt in plain text, permanently.

PGHOST=localhost
PGPORT=5432
PGDATABASE=riskradar
PGUSER=postgres

# Origin allowed by CORS. The Angular dev server's real default port.
CORS_ORIGIN=http://localhost:4200

# T2b: server-side sessions (schema_session_addendum.sql). SESSION_COOKIE_SECURE
# must be true behind real TLS -- it defaults false only because local dev is
# plain http://localhost:4200, where a Secure cookie would never be sent.
SESSION_COOKIE_NAME=rr_session
SESSION_LIFETIME_HOURS=24
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# There is deliberately NO PGPASSWORD key here.
#
# Putting one in this file would not work and would fail confusingly: the API
# reads .env through pydantic-settings, which parses the file itself and does
# NOT export into the process environment, and app/config.py has no password
# field. So a PGPASSWORD set here is read by nobody — asyncpg never sees it,
# and you would get an authentication failure with nothing to explain it.
#
# Use a pgpass file instead. On Windows:
#   %APPDATA%\postgresql\pgpass.conf
# one line, no spaces:
#   localhost:5432:riskradar:postgres:yourpassword
#
# Both psql and asyncpg read it automatically — asyncpg resolves the Windows
# location via compat.get_pg_home_directory(), so the app needs no password
# setting of any kind. The password never enters the environment, the shell
# history, a transcript or this repository.
#
# If you must use the environment instead, set PGPASSWORD in the real shell
# environment before launching uvicorn — not in this file.
# ---------------------------------------------------------------------------
