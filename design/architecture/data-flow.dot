digraph FLOW {
  rankdir=LR; splines=spline; nodesep=0.32; ranksep=0.62;
  graph [fontname="Helvetica", fontsize=15, labelloc=t, label="Risk Radar — Vulnerability Data Flow (D2)\nraw value → normalisation → indices → vulnerability → projection → monitoring   |   2026-07-29\n\nSolid border = built and verified   |   dashed = designed, not yet implemented\nGenerated by design/architecture/generate_diagrams.py — do not hand-edit"];
  node [fontname="Helvetica", fontsize=10.5, margin="0.18,0.12"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.75];
  subgraph cluster_src {
    label="1 · Raw values — three tracks, one schema"; fontcolor="#c77400"; color="#c77400"; style=rounded; fontsize=11;
  s_xl [label="Excel import\nsource = 'data'", shape=box, style="rounded,filled,dashed", fillcolor="#c7740018", color="#c77400", penwidth=1.4, fontcolor="#1c2b26"];
  s_ex [label="Expert entry\nsource = 'expert'", shape=box, style="rounded,filled,dashed", fillcolor="#c7740018", color="#c77400", penwidth=1.4, fontcolor="#1c2b26"];
  s_co [label="Community rating\nsource = 'community'", shape=box, style="rounded,filled,dashed", fillcolor="#c7740018", color="#c77400", penwidth=1.4, fontcolor="#1c2b26"];
  s_tb [label="Spatial toolbox\nderivation = 'computed'", shape=box, style="rounded,filled,dashed", fillcolor="#00838f18", color="#00838f", penwidth=1.4, fontcolor="#1c2b26"];
  }
  v_batch [label="import_batch\nvalidates _META,\nstructure, DS codes\nerrors → JSONB", shape=box, style="rounded,filled,dashed", fillcolor="#00695c18", color="#00695c", penwidth=1.4, fontcolor="#1c2b26"];
  v_raw [label="indicator_value.raw_value\nnative units, never normalised\nyear_start / year_end", shape=cylinder, style="filled", fillcolor="#2e7d3218", color="#2e7d32", penwidth=2, fontcolor="#1c2b26"];
  subgraph cluster_rules {
    label="2 · Period rules (A3, decided 2026-07-26)"; fontcolor="#616161"; color="#616161"; style=rounded; fontsize=11;
  r_agg [label="period_aggregation\n160 average (a typical year)\n11 fixed_window · 3 max", shape=note, style="filled", fillcolor="#61616118", color="#616161", penwidth=2, fontcolor="#1c2b26"];
  r_yr [label="iv_for_year()\n2025 is in BOTH periods →\nlatest period wins", shape=note, style="filled", fillcolor="#61616118", color="#616161", penwidth=2, fontcolor="#1c2b26"];
  }
  n_norm [label="3 · Normalisation (B3)\nserver-side, never in Excel\nminmax | zscore\npooled | per_year | fixed\n→ [0,1]", shape=box, style="rounded,filled,dashed", fillcolor="#00695c18", color="#00695c", penwidth=1.4, fontcolor="#1c2b26"];
  w_prof [label="4 · Weighting\nprofile_indicator\nper province × sector × hazard\nΣ = 100 per domain\n+ raises / − lowers", shape=box, style="rounded,filled", fillcolor="#2e7d3218", color="#2e7d32", penwidth=2, fontcolor="#1c2b26"];
  w_gate [label="v_profile_readiness\nany weight NULL →\nREFUSE to compute\n(1,783 of 3,664 today)", shape=note, style="filled", fillcolor="#c0392b18", color="#c0392b", penwidth=2, fontcolor="#1c2b26"];
  x_haz [label="hazard_index ∈ [0,1]", shape=box, style="rounded,filled,dashed", fillcolor="#00695c18", color="#00695c", penwidth=1.4, fontcolor="#1c2b26"];
  x_exp [label="exposure_index ∈ [0,1]", shape=box, style="rounded,filled,dashed", fillcolor="#00695c18", color="#00695c", penwidth=1.4, fontcolor="#1c2b26"];
  x_vul [label="vulnerability_index\n= f(Exposure, Hazard)\nper DS division · sector × hazard", shape=box, style="rounded,filled,dashed", fillcolor="#00695c18", color="#00695c", penwidth=1.4, fontcolor="#1c2b26"];
  d_vr [label="vulnerability_result\nprofile_id pins the exact\nweights used → every\nscore stays explainable", shape=cylinder, style="filled", fillcolor="#2e7d3218", color="#2e7d32", penwidth=2, fontcolor="#1c2b26"];
  p_ssp [label="5 · SSP scenario (B5)\nscenario_parameter\nshifts inputs\nSSP1..SSP5", shape=box, style="rounded,filled,dashed", fillcolor="#ad145718", color="#ad1457", penwidth=1.4, fontcolor="#1c2b26"];
  p_imp [label="impact_projection\nper sector / subsector", shape=box, style="rounded,filled,dashed", fillcolor="#ad145718", color="#ad1457", penwidth=1.4, fontcolor="#1c2b26"];
  m_obs [label="6 · monitoring_observation\nactual observed outcome", shape=box, style="rounded,filled,dashed", fillcolor="#ad145718", color="#ad1457", penwidth=1.4, fontcolor="#1c2b26"];
  m_cmp [label="M1  predicted vs actual\n→ alerts, model feedback", shape=box, style="rounded,filled,dashed", fillcolor="#ad145718", color="#ad1457", penwidth=1.4, fontcolor="#1c2b26"];
  o_map [label="vector tiles (MVT)\n→ OpenLayers choropleth\n3 tracks side by side", shape=box, style="rounded,filled,dashed", fillcolor="#1565c018", color="#1565c0", penwidth=1.4, fontcolor="#1c2b26"];
  s_xl -> v_batch;  s_ex -> v_raw;  s_co -> v_raw;
  s_tb -> v_raw [label="computation_job_id\nrequired (CHECK)", style=dashed];
  v_batch -> v_raw;
  r_agg -> n_norm [style=dashed];  r_yr -> n_norm [style=dashed];
  v_raw -> n_norm;
  n_norm -> w_prof;
  w_gate -> w_prof [style=dashed, color="#c0392b"];
  w_prof -> x_haz [label="domain =\nhazard"];
  w_prof -> x_exp [label="domain =\nexposure"];
  x_haz -> x_vul;  x_exp -> x_vul;
  x_vul -> d_vr;
  d_vr -> o_map;
  d_vr -> p_ssp;  p_ssp -> p_imp;  p_imp -> m_cmp;
  m_obs -> m_cmp;
  m_cmp -> n_norm [style=dashed, label="feedback", constraint=false];
}