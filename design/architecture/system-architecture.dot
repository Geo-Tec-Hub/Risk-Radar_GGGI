digraph ARCH {
  rankdir=TB; splines=spline; nodesep=0.45; ranksep=0.85;
  graph [fontname="Helvetica", fontsize=15, labelloc=t, label="Risk Radar — System Architecture (D1)\nDS-division Climate Vulnerability Assessment, Sri Lanka   |   2026-07-29\n\nSolid border = built and verified   |   dashed = designed, not yet implemented\nGenerated by design/architecture/generate_diagrams.py — do not hand-edit"];
  node [fontname="Helvetica", fontsize=10.5, margin="0.18,0.12"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.75];
  subgraph cluster_users {
    label="Users & roles (B4)"; fontcolor="#7c5cbf"; color="#7c5cbf"; style=rounded; fontsize=11;
  u_officer [label="Data Officer\nprovincial data entry", shape=box, style="rounded,filled,dashed", fillcolor="#7c5cbf18", color="#7c5cbf", penwidth=1.4, fontcolor="#1c2b26"];
  u_expert [label="Expert\nknowledge-based values", shape=box, style="rounded,filled,dashed", fillcolor="#7c5cbf18", color="#7c5cbf", penwidth=1.4, fontcolor="#1c2b26"];
  u_comm [label="General User\n1–5 severity ratings", shape=box, style="rounded,filled,dashed", fillcolor="#7c5cbf18", color="#7c5cbf", penwidth=1.4, fontcolor="#1c2b26"];
  u_admin [label="Administrator\nusers, catalog, versions", shape=box, style="rounded,filled,dashed", fillcolor="#7c5cbf18", color="#7c5cbf", penwidth=1.4, fontcolor="#1c2b26"];
  u_public [label="Public\nread-only map, no login", shape=box, style="rounded,filled,dashed", fillcolor="#7c5cbf18", color="#7c5cbf", penwidth=1.4, fontcolor="#1c2b26"];
  }
  subgraph cluster_in {
    label="Inputs"; fontcolor="#c77400"; color="#c77400"; style=rounded; fontsize=11;
  i_wb [label="243 Excel workbooks\n2 period tabs × 330 DS rows\nreference-only WEIGHTS tab", shape=box, style="rounded,filled", fillcolor="#c7740018", color="#c77400", penwidth=2, fontcolor="#1c2b26"];
  i_shp [label="Official shapefiles\nADM1 · ADM2 · ADM3 (330)\nEPSG:4326", shape=box, style="rounded,filled", fillcolor="#c7740018", color="#c77400", penwidth=2, fontcolor="#1c2b26"];
  i_panel [label="Local expert panel\nreviews OFFLINE →\nrecorded as panel_note", shape=note, style="filled", fillcolor="#c7740018", color="#c77400", penwidth=2, fontcolor="#1c2b26"];
  i_docs [label="Policy / adaptation\ndocuments (A1)", shape=box, style="rounded,filled,dashed", fillcolor="#c7740018", color="#c77400", penwidth=1.4, fontcolor="#1c2b26"];
  }
  subgraph cluster_fe {
    label="Frontend — Angular + TypeScript + OpenLayers (Stage 5)"; fontcolor="#1565c0"; color="#1565c0"; style=rounded; fontsize=11;
  f_map [label="Map dashboard (F2)\nDS choropleth · track /\nhazard / sector / SSP toggles", shape=box, style="rounded,filled,dashed", fillcolor="#1565c018", color="#1565c0", penwidth=1.4, fontcolor="#1c2b26"];
  f_imp [label="Import wizard (F3)\nupload → confirm weights", shape=box, style="rounded,filled,dashed", fillcolor="#1565c018", color="#1565c0", penwidth=1.4, fontcolor="#1c2b26"];
  f_wts [label="Profile weights (F3)\nedit any time · versioned", shape=box, style="rounded,filled,dashed", fillcolor="#1565c018", color="#1565c0", penwidth=1.4, fontcolor="#1c2b26"];
  f_fb [label="Expert + community\nforms (F4)", shape=box, style="rounded,filled,dashed", fillcolor="#1565c018", color="#1565c0", penwidth=1.4, fontcolor="#1c2b26"];
  f_tool [label="Map toolbox (F6)\ncalculate → review → commit", shape=box, style="rounded,filled,dashed", fillcolor="#1565c018", color="#1565c0", penwidth=1.4, fontcolor="#1c2b26"];
  f_chat [label="Agent chat (A3)", shape=box, style="rounded,filled,dashed", fillcolor="#1565c018", color="#1565c0", penwidth=1.4, fontcolor="#1c2b26"];
  }
  subgraph cluster_api {
    label="Backend — FastAPI (Phase 1)"; fontcolor="#00695c"; color="#00695c"; style=rounded; fontsize=11;
  a_ing [label="B2  Catalog + ingestion\nPOST /imports\nreads WEIGHTS tab, validates _META", shape=box, style="rounded,filled,dashed", fillcolor="#00695c18", color="#00695c", penwidth=1.4, fontcolor="#1c2b26"];
  a_wts [label="B2  PUT /profiles/{scope}/weights\nsave_profile_weights()", shape=box, style="rounded,filled,dashed", fillcolor="#00695c18", color="#00695c", penwidth=1.4, fontcolor="#1c2b26"];
  a_eng [label="B3  Normalisation +\nvulnerability engine", shape=box, style="rounded,filled,dashed", fillcolor="#00695c18", color="#00695c", penwidth=1.4, fontcolor="#1c2b26"];
  a_auth [label="B4  JWT auth + roles", shape=box, style="rounded,filled,dashed", fillcolor="#00695c18", color="#00695c", penwidth=1.4, fontcolor="#1c2b26"];
  a_ssp [label="B5  SSP scenarios +\nimpact projection", shape=box, style="rounded,filled,dashed", fillcolor="#00695c18", color="#00695c", penwidth=1.4, fontcolor="#1c2b26"];
  a_geo [label="B6  GeoJSON map API", shape=box, style="rounded,filled,dashed", fillcolor="#00695c18", color="#00695c", penwidth=1.4, fontcolor="#1c2b26"];
  a_shp [label="B7  Spatial layer import", shape=box, style="rounded,filled,dashed", fillcolor="#00695c18", color="#00695c", penwidth=1.4, fontcolor="#1c2b26"];
  a_tool [label="B8  Spatial toolbox\n→ computation_result", shape=box, style="rounded,filled,dashed", fillcolor="#00695c18", color="#00695c", penwidth=1.4, fontcolor="#1c2b26"];
  }
  subgraph cluster_db {
    label="PostgreSQL 15 + PostGIS  (+ pgvector, optional)  — BUILT 2026-07-29"; fontcolor="#2e7d32"; color="#2e7d32"; style=rounded; fontsize=11;
  d_ref [label="Reference\n9 provinces · 3 hazards\n8 sectors · 12 subsectors\n330 DS divisions (geom)", shape=cylinder, style="filled", fillcolor="#2e7d3218", color="#2e7d32", penwidth=2, fontcolor="#1c2b26"];
  d_cat [label="indicator_catalog\n174 variables\n+ 269 aliases", shape=cylinder, style="filled", fillcolor="#2e7d3218", color="#2e7d32", penwidth=2, fontcolor="#1c2b26"];
  d_prof [label="vulnerability_profile 243\nprofile_indicator 3,664\n1,783 weights still NULL", shape=cylinder, style="filled", fillcolor="#2e7d3218", color="#2e7d32", penwidth=2, fontcolor="#1c2b26"];
  d_val [label="indicator_value\nraw + normalised\nsource: data|expert|community", shape=cylinder, style="filled", fillcolor="#2e7d3218", color="#2e7d32", penwidth=2, fontcolor="#1c2b26"];
  d_res [label="vulnerability_result\nimpact_projection\nmonitoring_observation", shape=cylinder, style="filled", fillcolor="#2e7d3218", color="#2e7d32", penwidth=2, fontcolor="#1c2b26"];
  d_sp [label="spatial_layer / feature\ncomputation_job / result", shape=cylinder, style="filled", fillcolor="#00838f18", color="#00838f", penwidth=2, fontcolor="#1c2b26"];
  d_vec [label="agent_document\nagent_embedding  vector(1024)", shape=cylinder, style="filled,dashed", fillcolor="#5d403718", color="#5d4037", penwidth=1.4, fontcolor="#1c2b26"];
    { rank=same; d_ref; d_cat; d_prof; d_val; d_res; d_sp; d_vec; }
  }
  subgraph cluster_ag {
    label="AI agent layer — RAG (Phase 3)"; fontcolor="#5d4037"; color="#5d4037"; style=rounded; fontsize=11;
  g_emb [label="A1  Embedding pipeline", shape=box, style="rounded,filled,dashed", fillcolor="#5d403718", color="#5d4037", penwidth=1.4, fontcolor="#1c2b26"];
  g_api [label="A2  RAG endpoints\n“impact? measures?”", shape=box, style="rounded,filled,dashed", fillcolor="#5d403718", color="#5d4037", penwidth=1.4, fontcolor="#1c2b26"];
  g_llm [label="Self-hosted LLM\n+ embedding model\n(not yet chosen)", shape=note, style="filled,dashed", fillcolor="#5d403718", color="#5d4037", penwidth=1.4, fontcolor="#1c2b26"];
  }
  m_mon [label="M1  Monitoring\npredicted vs actual", shape=box, style="rounded,filled,dashed", fillcolor="#ad145718", color="#ad1457", penwidth=1.4, fontcolor="#1c2b26"];
  u_officer -> f_imp;  u_officer -> f_wts;
  u_expert  -> f_fb;   u_expert  -> f_chat;
  u_comm    -> f_fb;   u_public  -> f_map [label="no login"];
  u_admin   -> f_wts;  u_admin   -> f_tool;
  i_panel -> f_wts [style=dashed, label="sign-off\nas panel_note"];
  i_wb  -> f_imp;
  i_shp -> a_shp;  i_docs -> g_emb;
  f_imp  -> a_ing;  f_wts -> a_wts;  f_fb -> a_ing;
  f_map  -> a_geo;  f_tool -> a_tool;  f_chat -> g_api;
  f_map  -> a_ssp [style=dashed];
  a_auth -> f_imp [style=dashed, label="role gates"];
  a_ing  -> d_val;  a_ing -> d_cat [label="alias resolve"];
  a_wts  -> d_prof [label="new version\non every save"];
  a_eng  -> d_val [dir=back, label="reads normalised"];
  a_eng  -> d_prof [dir=back, label="weights"];
  a_eng  -> d_res;
  a_ssp  -> d_res;  a_geo -> d_ref [dir=back];  a_geo -> d_res [dir=back];
  a_shp  -> d_sp;   a_tool -> d_sp;
  a_tool -> d_val [label="commit only", style=dashed];
  g_emb  -> d_vec;  g_api -> d_vec [dir=back];  g_api -> g_llm;
  d_res  -> m_mon;  m_mon -> d_res [label="observed"];
}